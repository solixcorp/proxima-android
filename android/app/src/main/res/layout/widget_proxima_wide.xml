<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:text="@string/widget_off"
            android:textColor="@color/widget_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:text="@string/app_name"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />
        <Chronometer
            android:id="@+id/widget_uptime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_uptime_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/widget_elapsed_empty"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:includeFontPadding="false" />

    </LinearLayout>

    <ImageView
        android:id="@+id/widget_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/widget_button_disconnected"
        android:src="@drawable/widget_ic_power"
        android:padding="12dp"
        android:contentDescription="@string/widget_connect"
        android:focusable="true"
        android:clickable="true" />
</LinearLayout>
